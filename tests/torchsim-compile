#!/usr/bin/env python
"""The compiler driver WITH the stages that run what it built.

Same CLI as `pytorchsim-triton-compiler`, plus `spike` and `verify` (and `togcheck` with
--tog), which the suite needs and the compiler does not have: importing tests.runtime registers
them. --timing is this driver's own, as PyTorchSim's timing mode is its own: it compiles with
--tog and times the kernel with gem5 and TOGSim after the Spike run.
"""
import os
import sys

_HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(_HERE))
sys.path.insert(0, _HERE)

os.environ.setdefault("TORCHSIM_COMPILE_TARGET", "tpuv6e")

# torch is here to make reference tensors on the CPU, nothing more. Left to
# itself it also autoloads PyTorchSim's out-of-tree device, which drags in all of
# torch._dynamo -- measured 44s against 2.5s. setdefault, so a device run can say no.
os.environ.setdefault("TORCH_DEVICE_BACKEND_AUTOLOAD", "0")

import runtime  # noqa: E402  -- registers spike, verify and togcheck
from pytorchsim_triton_compiler import cli  # noqa: E402


def _main():
    """`doctor` reports the simulators too; everything else is the compiler's."""
    if "--timing" in sys.argv[1:]:
        runtime.install_timing()
    ap = cli.parser()
    ap.add_argument("--timing", action="store_true",
                    help="--tog, then gem5 tile cycles and a TOGSim run after spike")
    args = ap.parse_args()
    args.tog = args.tog or args.timing
    rc = cli.run(ap, args)
    if args.kernel == "doctor":
        from runtime.device import doctor
        print()
        rc = 0 if (doctor.doctor() and rc == 0) else 1
    return rc


if __name__ == "__main__":
    sys.exit(_main())
