{
  // Debug triton-shared-opt (C++) on a kernel of your choice.
  //
  // Pick a configuration, hit F5, and VS Code emits the FOCUSED kernel's
  // work/_debug/02-ttclean.mlir first, then gdb starts triton-shared-opt on it
  // with the passes named in the configuration.
  //
  // IT IS 02-ttclean, NOT 01-ttir. Stage 3 hands triton-shared-opt 02-ttclean.mlir,
  // because the text drop in front of it takes out what it cannot read at all
  // (ttg.barrier) or has no use for (llvm.intr.assume). Debugging 01-ttir.mlir
  // debugs an input the pipeline never gives it, and a kernel with a tl.assume
  // dies on the parse.
  //
  // The pass ladder below mirrors pipeline.py's TTSHARED_PIPELINE, which is the
  // only copy of that list. `python tools/lower_steps.py <kernel>` walks the
  // same steps without a debugger and writes one file per step.
  //
  // Useful breakpoints -- named by SYMBOL, so they survive an edit above them:
  //   b PtrAnalysis::rewriteLoadOp     every pointer decision starts here
  //   b PtrAnalysis::recordDemotion    why the ladder was climbed down
  //   b PtrAnalysis::visitOperand      the arithmetic walk itself
  //   b MaskState::parseCmp            why a mask failed
  //   b MaskState::parseLoopIterArg    a loop-carried mask's bound
  //
  // The binary is built with debug_info and is not stripped, so source-level
  // stepping works without rebuilding anything.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ts-opt 1: --triton-to-structured",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:tnpu.tritonSharedOpt}",
      "args": [
        "--triton-to-structured",
        "${workspaceFolder}/work/_debug/02-ttclean.mlir",
        "-o", "${workspaceFolder}/work/_debug/out.mlir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "torchsim-compile: emit triton-shared input",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      // Same, but printing which demotion each refusal was and by which
      // arithmetic -- read this before setting a breakpoint in the walk.
      "name": "ts-opt 1b: --triton-to-structured=report-demotions",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:tnpu.tritonSharedOpt}",
      "args": [
        "--triton-to-structured=report-demotions",
        "${workspaceFolder}/work/_debug/02-ttclean.mlir",
        "-o", "${workspaceFolder}/work/_debug/out.mlir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "torchsim-compile: emit triton-shared input",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "ts-opt 2: + --triton-to-unstructured",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:tnpu.tritonSharedOpt}",
      "args": [
        "--triton-to-structured",
        "--cse", "--canonicalize", "--remove-dead-values", "--canonicalize",
        "--triton-to-unstructured",
        "${workspaceFolder}/work/_debug/02-ttclean.mlir",
        "-o", "${workspaceFolder}/work/_debug/out.mlir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "torchsim-compile: emit triton-shared input",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      "name": "ts-opt 3: + --triton-arith-to-linalg",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:tnpu.tritonSharedOpt}",
      "args": [
        "--triton-to-structured",
        "--cse", "--canonicalize", "--remove-dead-values", "--canonicalize",
        "--triton-to-unstructured",
        "--triton-arith-to-linalg=tensor-ptr-to-linalg=true",
        "${workspaceFolder}/work/_debug/02-ttclean.mlir",
        "-o", "${workspaceFolder}/work/_debug/out.mlir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "torchsim-compile: emit triton-shared input",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      // The whole of stage 3, byte-identical to what pipeline.py runs. Its
      // output IS 03-ttshared.mlir; tts.make_tptr/load/store survive, because
      // our passes own that lowering.
      "name": "ts-opt 4: the whole of stage 3",
      "type": "cppdbg",
      "request": "launch",
      "program": "${config:tnpu.tritonSharedOpt}",
      "args": [
        "--triton-to-structured",
        "--cse", "--canonicalize", "--remove-dead-values", "--canonicalize",
        "--triton-to-unstructured",
        "--triton-arith-to-linalg=tensor-ptr-to-linalg=true",
        "--triton-ptr-to-memref",
        "--triton-to-ptr",
        "--linalg-fold-unit-extent-dims",
        "--mlir-print-op-generic",
        "${workspaceFolder}/work/_debug/02-ttclean.mlir",
        "-o", "${workspaceFolder}/work/_debug/out.mlir"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "torchsim-compile: emit triton-shared input",
      "MIMode": "gdb",
      "setupCommands": [
        { "description": "pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    },
    {
      // The Python side: stage 4 (pytorchsim_triton_compiler/elf/passes/) on the same
      // kernel. Not triton-shared, but it is the other half of every question here.
      "name": "python: stage 4 (elf/passes)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/pytorchsim-triton-compiler",
      "args": ["${input:kernel}", "--to", "transform", "-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "kernel",
      "type": "pickString",
      "description": "kernel to debug",
      "default": "tests/cases/smoke/add.py",
      "options": [
        "tests/cases/smoke/add.py",
        "tests/cases/smoke/mul.py",
        "tests/cases/smoke/relu.py",
        "tests/cases/smoke/gemm.py",
        "tests/cases/smoke/bmm.py"
      ]
    }
  ]
}
