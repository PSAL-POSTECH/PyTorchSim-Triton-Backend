# pytorchsim-triton-compiler with no --workdir writes ./work/<kernel name>/: the IR at every
# stage, the ELF, the stage log. All of it is reproducible from the kernel file.
work/

__pycache__/
*.pyc

# Agent worktrees and session state: separate checkouts, never part of a commit.
.claude/

# Study notes: model structures, op inventories, parameter counts. Written to read, not to
# build from -- they go stale. The kernels in tests/cases/ are the part that is checked.
study/

# setuptools leaves these behind on `pip install .`
build/
*.egg-info/
dist/

# Editor state; keep your own uncommitted.
.vscode/
