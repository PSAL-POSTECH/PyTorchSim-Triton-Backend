# Targets: a target is one directory, targets/<target>/, whose CMakeLists.txt calls pytorchsim_target() (as
# Triton's third_party/<backend>/ is added by add_subdirectory). The dialect build and the Triton plugin both
# include this file and call pytorchsim_include_targets(); neither lists a target itself.
set(PYTORCHSIM_TARGETS_GLOB "${CMAKE_CURRENT_LIST_DIR}/../../targets/*/CMakeLists.txt")

# pytorchsim_target(<dialect> INCLUDE <dir> TD <.td> SOURCES <C++...> HEADER <include> CLASS <dialect class>
#                   [FOLDS <function> FOLDS_HEADER <include> FOLD_SOURCES <C++...>]): recorded, not built.
function(pytorchsim_target dialect)
  cmake_parse_arguments(K "" "INCLUDE;TD;HEADER;CLASS;FOLDS;FOLDS_HEADER" "SOURCES;FOLD_SOURCES" ${ARGN})
  cmake_path(SET K_TD NORMALIZE "${K_TD}")
  foreach(list SOURCES FOLD_SOURCES)
    set(normal "")
    foreach(src ${K_${list}})
      cmake_path(SET src NORMALIZE "${src}")
      list(APPEND normal "${src}")
    endforeach()
    set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_${list} ${normal})
  endforeach()
  set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_NAMES "${dialect}")
  set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_INCLUDES "${K_INCLUDE}")
  set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_TD_FILES "${K_TD}")
  set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_HEADERS "${K_HEADER}")
  set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_CLASSES "${K_CLASS}")
  if(K_FOLDS)
    set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_FOLDS_HEADERS "${K_FOLDS_HEADER}")
    set_property(GLOBAL APPEND PROPERTY PYTORCHSIM_TARGET_FOLD_ENTRIES
                 "PYTORCHSIM_TARGET_FOLD(\"${dialect}\", ${K_FOLDS})")
  endif()
endfunction()

# Every targets/<target>/ added, then TARGET_<what> for each list pytorchsim_target() records, and
# <gen>/TargetFolds.h.inc: every target's dialect name and the function stating its lane reduces.
macro(pytorchsim_include_targets gen)
  file(GLOB _target_files CONFIGURE_DEPENDS "${PYTORCHSIM_TARGETS_GLOB}")
  foreach(_f ${_target_files})
    get_filename_component(_dir "${_f}" DIRECTORY)
    get_filename_component(_name "${_dir}" NAME)
    add_subdirectory("${_dir}" "${CMAKE_CURRENT_BINARY_DIR}/targets/${_name}")
  endforeach()
  foreach(_what NAMES INCLUDES TD_FILES SOURCES FOLD_SOURCES HEADERS CLASSES FOLDS_HEADERS FOLD_ENTRIES)
    get_property(TARGET_${_what} GLOBAL PROPERTY PYTORCHSIM_TARGET_${_what})
  endforeach()
  if(NOT TARGET_NAMES)
    message(FATAL_ERROR "no target: no ${PYTORCHSIM_TARGETS_GLOB} calls pytorchsim_target()")
  endif()
  set(_inc "// Generated by dialect/src/targets.cmake from every target's CMakeLists.txt; do not edit.\n")
  foreach(_h ${TARGET_FOLDS_HEADERS})
    string(APPEND _inc "#include \"${_h}\"\n")
  endforeach()
  list(TRANSFORM TARGET_NAMES PREPEND "\"" OUTPUT_VARIABLE _names)
  list(TRANSFORM _names APPEND "\"")
  string(REPLACE ";" ", " _names "${_names}")
  string(REPLACE ";" " " _entries "${TARGET_FOLD_ENTRIES}")
  string(APPEND _inc "#define PYTORCHSIM_TARGET_NAMES ${_names}\n")
  string(APPEND _inc "#define PYTORCHSIM_TARGET_FOLD_LIST ${_entries}\n")
  file(CONFIGURE OUTPUT "${gen}/PyTorchSim/TargetFolds.h.inc" CONTENT "${_inc}")
endmacro()
