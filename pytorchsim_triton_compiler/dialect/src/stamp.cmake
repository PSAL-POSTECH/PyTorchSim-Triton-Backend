# The .td revisions these bindings were generated from, written beside them: TDS (the common dialects') and
# TARGET_TDS (every target's), each a |-separated list; a target's .td also by its path under PACKAGE.
string(REPLACE "|" ";" tds "${TDS}")
string(REPLACE "|" ";" target_tds "${TARGET_TDS}")
set(shas "")
set(sources "")
foreach(td ${tds} ${target_tds})
  get_filename_component(name "${td}" NAME)
  file(SHA256 "${td}" sha)
  string(APPEND shas "    \"${name}\": \"${sha}\",\n")
endforeach()
foreach(td ${target_tds})
  get_filename_component(name "${td}" NAME)
  file(RELATIVE_PATH rel "${PACKAGE}" "${td}")
  string(APPEND sources "    \"${name}\": \"${rel}\",\n")
endforeach()
file(WRITE "${OUT}"
"\"\"\"generated by dialect/src/stamp.cmake -- do not edit.
The .td files these bindings came from. dialect/pytorchsim.py compares them.\"\"\"
TD_SHA256 = {
${shas}}
TARGET_TD_SOURCES = {
${sources}}
")
