# The Triton route on the LOCAL toolchain setup/local-toolchain.sh built. Source it.
# Everything lives under one root on local disk; nothing points at NFS.
_tsl=${TORCHSIM_LOCAL_ROOT:-@ROOT@}

export TORCHSIM_COMPILE_DIR=$_tsl/src/pytorchsim-triton-compiler
export TORCHSIM_DIR=$_tsl/src/PyTorchSim

# one LLVM for both sides: the compiler's stages and PyTorchSim's TOG builder
export TORCHSIM_LLVM_PATH=$_tsl/llvm23/install/bin
export TORCHSIM_COMPILE_LLVM_PATH=$_tsl/llvm23/install/bin
# stages 1 and 2: an unmodified Triton (v3.7.0) with the torchsim extension plugged in
export TORCHSIM_COMPILE_TRITON_PYTHON=$_tsl/src/triton/python
export TORCHSIM_COMPILE_TRITON_EXT=$_tsl/build/torchsim-triton-ext/libtorchsim_triton_ext.so
export TORCHSIM_COMPILE_TORCHSIM_DIALECT=$_tsl/toolchain/torchsim-dialect

export TORCHSIM_COMPILE_SPIKE=$_tsl/toolchain/spike/bin/spike
export TORCHSIM_COMPILE_VCIX_MODEL=$_tsl/build/vcix/libtpu.so
export TORCHSIM_COMPILE_PK=$_tsl/toolchain/pk
export TORCHSIM_COMPILE_TOGSIM_DIR=$TORCHSIM_DIR
export TORCHSIM_COMPILE_TOGSIM_INCLUDE=$TORCHSIM_DIR/TOGSim/include
export TORCHSIM_COMPILE_GEM5=$_tsl/src/gem5/build/RISCV/gem5.opt
export GEM5_PATH=$TORCHSIM_COMPILE_GEM5

export RISCV=$_tsl/toolchain/riscv
case ":$PATH:" in *":$RISCV/bin:"*) ;; *) export PATH=$RISCV/bin:$PATH ;; esac
export TORCHSIM_COMPILE_RISCV_GCC=$RISCV/bin/riscv64-unknown-elf-gcc
export TORCHSIM_COMPILE_RISCV_OBJDUMP=$RISCV/bin/riscv64-unknown-elf-objdump
export TORCHSIM_COMPILE_RISCV_READELF=$RISCV/bin/riscv64-unknown-elf-readelf
export TORCHSIM_COMPILE_RISCV_NM=$RISCV/bin/riscv64-unknown-elf-nm

export TORCHSIM_TRITON_CODEGEN=1
export LIT_USE_INTERNAL_SHELL=1

# one dump path per run: the kernel cache keys on source text alone
mkdir -p $_tsl/run
export TORCHSIM_DUMP_PATH=${TORCHSIM_DUMP_PATH:-$_tsl/run/dump-$$}
export TORCHSIM_LOG_PATH=$_tsl/run/togsim_results

PYTHONPATH="$(printf '%s' "${PYTHONPATH:-}" | tr ':' '\n' | grep -v -e '^/riscv-llvm/' -e '^/workspace/' | paste -sd: -)"
export PYTHONPATH="$TORCHSIM_DIR/PyTorchSimDevice:$TORCHSIM_DIR${PYTHONPATH:+:$PYTHONPATH}"

# the reference machine is TPU v6e; TORCHSIM_TIMING_MODE=1 turns timing on for one run
export TOGSIM_CONFIG=$TORCHSIM_DIR/configs/systolic_ws_256x256_c1_simple_noc_tpuv6e_functional_only.yml
export TORCHSIM_COMPILE_TARGET=$TORCHSIM_COMPILE_DIR/tests/targets/tpuv6e.json
for _tsl_f in "$TOGSIM_CONFIG" "$TORCHSIM_COMPILE_TARGET"; do
  [ -f "$_tsl_f" ] || echo "env.sh: MISSING $_tsl_f" >&2
done
unset _tsl _tsl_f
