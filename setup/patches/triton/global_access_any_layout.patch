+                                             op.getType().getShape(), dstEnc,
+                                             op.getLoc())))
+      return failure();
+    auto retTy = RankedTensorType::get(op.getType().getShape(),
+                                       op.getType().getElementType(), dstEnc);
+    addNamedAttrs(rewriter.replaceOpWithNewOp<triton::ReshapeOp>(
+                      op, retTy, adaptor.getSrc(), op.getAllowReorder(),
+                      op.getEfficientLayout()),
+                  adaptor.getAttributes());
+    return success();
+  }
+};
