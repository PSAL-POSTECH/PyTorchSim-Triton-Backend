# Every external pin and every install location. Sourced by bash; toolchain.sh reads it.

# LLVM: our fork (the VCIX ops stage 5 mints), based on the revision Triton pins. THAT repository
# builds it and publishes llvm23-<sha12>; this one only downloads the asset.
LLVM_REPO=https://github.com/PSAL-POSTECH/llvm-project.git
LLVM_BRANCH=torchsim-triton-3.8
LLVM_SHA=65f56cd56954c79db498c383d2e8c6aa15228e97
# Triton: upstream v3.8.0 with one edit, its tensor numel limit (TRITON_MAX_TENSOR_NUMEL, maxTensorNumElements)
# raised from 1<<20 to TRITON_MAX_TENSOR_NUMEL below, so a tile that fills a 256-lane, 512 KB-a-lane scratchpad
# compiles. Everything else the route adds to it is pytorchsim_triton_compiler/triton_extension/.
TRITON_REPO=https://github.com/triton-lang/triton.git
TRITON_SHA=c01b6774b1865984607d89d89d3a10833de92037
TRITON_MAX_TENSOR_NUMEL=67108864
# nlohmann/json: Triton's own pin (cmake/json-version.txt), handed to its configure offline.
TRITON_JSON_VERSION=v3.11.3
TRITON_JSON_SHA256=a22461d13119ac5c78f205d3df1db13403e58ce1bb1794edc9313677313f4a9d
# TOGSim and the machine configs are the TOGSim repository's, at the commit the third_party/TOGSim
# submodule pins: the header a TOG is compiled against moves with this checkout.

# spike, gem5, the RISC-V toolchain and pk are NOT built or downloaded here: they are the
# environment the vcix-accelerator submodule pins and publishes as $VCIX_ENV_IMAGE, which the
# Dockerfile is FROM. The tag hashes the submodule's setup/ tree, so a moved pin is a new image.
_VCIX_SRC="$(dirname "${BASH_SOURCE[0]}")/../third_party/vcix-accelerator"
VCIX_ENV_ROOT=${VCIX_ENV_ROOT:-$([ -d /opt/vcix-env ] && echo /opt/vcix-env || echo "${TORCHSIM_PREFIX:-/workspace}/vcix-env")}
[ -f "$_VCIX_SRC/setup/versions.env" ] \
  || { echo "third_party/vcix-accelerator is empty -- git submodule update --init" >&2; return 1 2>/dev/null || exit 1; }
eval "$(cd "$_VCIX_SRC" && . setup/versions.env >/dev/null 2>&1 \
        && declare -p IMAGE_REPO VCIX_ENV_ROOT TOOLCHAIN_ROOT SPIKE_BIN PK_BIN GEM5_BIN)"
# Empty inside an image build, where the submodule is a bare copy: the image was chosen by build-arg.
VCIX_ENV_IMAGE="$IMAGE_REPO:env-$({ git -C "$_VCIX_SRC" rev-parse HEAD:setup 2>/dev/null || true; } | cut -c1-12)"
[ "$VCIX_ENV_IMAGE" != "$IMAGE_REPO:env-" ] || VCIX_ENV_IMAGE=""

# The distribution layer (setup/system.sh): cmake + conan are the pair TOGSim's conanfile was
# resolved with; torch (CPU) gives the kernels their reference values.
HOST_CMAKE_VERSION=3.26.4
CONAN_VERSION=1.56.0
TORCH_VERSION=2.10.0
# nanobind: the 2.x line MLIR's bindings are built against (its requirements.txt: >=2.9,<3.0).
NANOBIND_VERSION=2.15.0

# One tree, the same names everywhere: /workspace in the images (the compiler's defaults),
# anywhere else with TORCHSIM_PREFIX set and toolchain.sh's `env` step sourced.
PREFIX=${TORCHSIM_PREFIX:-/workspace}
PYTHON=${TORCHSIM_PYTHON:-/usr/bin/python3.11}
BUILD_TOOLS=$PREFIX/build-tools
LLVM_ROOT=$PREFIX/LLVM_DIR/llvm-project
LLVM_INSTALL=$LLVM_ROOT/build/install
JSON_INSTALL=$PREFIX/nlohmann-json
# Not $PREFIX/triton: that shadows the `triton` package for anything run from $PREFIX.
TRITON_ROOT=$PREFIX/triton-src
TRITON_BUILD=$TRITON_ROOT/build
TOGSIM_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/third_party/TOGSim"
VCIX_BUILD=$PREFIX/vcix-build
# The vcix-accelerator models the targets run on, as its CMake targets (lib<name>.so in $VCIX_BUILD).
VCIX_MODELS="tpuv6"
DIALECT_BUILD=$PREFIX/torchsim-dialect-build
EXT_BUILD=$PREFIX/torchsim-triton-ext-build
# tools/dump_tpu_vliw.py's own interpreter (toolchain.sh's jaxtpu step); its pins are requirements-jax-tpu.txt.
JAX_TPU_PYTHON=${JAX_TPU_PYTHON:-python3.13}
JAX_TPU_VENV=$PREFIX/jax-tpu-venv
