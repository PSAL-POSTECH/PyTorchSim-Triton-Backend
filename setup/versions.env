# Pinned versions of every external dependency. restore.sh reads this.

# --- LLVM ---------------------------------------------------------------------
# Our fork, the VCIX ops with no destination, which stage 5 mints and upstream MLIR does not
# model, and an init tensor keeping its encoding in ElementwiseToLinalg. Triton is built against
# it and the compiler's MLIR bindings are its own, so one LLVM serves both sides.
# THAT REPOSITORY BUILDS IT. This one downloads the asset tagged llvm23-<sha12>
# and never compiles LLVM -- see setup/restore.sh's llvm step.
LLVM_REPO=https://github.com/PSAL-POSTECH/llvm-project.git
LLVM_BRANCH=torchsim-llvm23
LLVM_SHA=f9dd1012675ff3fa12954375ed5a2e67059e6c43
# --- triton -------------------------------------------------------------------
# Upstream's v3.7.0 release, unmodified: everything the route adds to it is extension/.
# Built once against the LLVM above with its symbols exposed (TRITON_EXT_ENABLED=ON).
TRITON_REPO=https://github.com/triton-lang/triton.git
TRITON_SHA=5f3f125e8f63c24613f1f73b937442864f263f94

# --- spike --------------------------------------------------------------------
# The fork with no accelerator of its own -- $VCIX_MODEL answers instead, and
# riscv/vcix_accel_extension.cc is the marker. The pin is the submodule's, not
# a copy here; toolchain_tag.sh hashes the gitlink, so the tag still moves.
_VCIX_SETUP="$(dirname "${BASH_SOURCE[0]}")/../third_party/vcix-accelerator/setup"
[ -f "$_VCIX_SETUP/versions.env" ] \
  || { echo "third_party/vcix-accelerator is empty -- git submodule update --init" >&2; return 1 2>/dev/null || exit 1; }
eval "$(cd "$_VCIX_SETUP/.." && . setup/versions.env >/dev/null 2>&1 \
        && declare -p SPIKE_REPO SPIKE_SHA GEM5_URL GEM5_SHA256 GEM5_TARGET \
                      TOOLCHAIN_URL TOOLCHAIN_SHA256 PK_REPO PK_SHA)"
# A MUST FOR THIS COMPILER, not a should, and for two reasons now.
#
# A wrapped access is lowered as several strided transfers sharing one tile, and
# each names its rows with the descriptor's box plus a per-axis "skip" bit in
# flags. An older spike does not read that bit, so every piece FILLS the rows its
# siblings just wrote and the tile keeps only the last one.
#
# AND THE DESCRIPTOR IS 160 BYTES NOW. +144/+152 carry the argument's range, and
# a masked-off write is parked OUTSIDE it on purpose -- nothing is reserved
# behind an output any more. An older spike does not read those fields, so that
# write lands for real, in memory the wrapper no longer allocates.
#
# AND AN INDIRECT INDEX IS SIGNED. The DMA loads it with load_uint8/16/32/64
# and the first three ZERO EXTEND a value the program means as signed: -128 in a
# four-byte field reads as 4294967168 and the address lands 2^34 past the tile.
# Eight bytes was always right, which is why this compiler used to widen every
# index tile to i64 -- a buffer and a copy per transfer. `df08f17` reads it
# signed and that widening is gone. The branch below is named after it; the
# reason went unrecorded here for a round because nothing in the suite held a
# negative index. ptr_gather_negative_index.py does now, in i32.
#
# All three are wrong NUMBERS, not errors. `vlane_start` (+133), pinned at
# 8e46ad6, is gone -- a piece names its rows with the box instead.
# AND THE CROSS-LANE UNIT, WHICH IS A MUST BY THE OLDEST REASON AGAIN. Stage 5
# mints `vcix.iv` with the unit's SIMM5 (torchsim-compile 479926b / 0de0301) and b0d82d0
# has no cross_lane_unit.cc: smoke/reduce dies on Spike with `An illegal
# instruction was executed!` at inst 0x2e82305b (custom-2). The unit landed
# 58bb96f (merge, 09-14), its three-field SIMM5 9e8f57c pairs with torchsim-compile
# 479926b, and the pattern-beside-the-data 9afe8a0 pairs with torchsim-compile 0de0301.
#
#     9f555b4  The install is a build product, not a thing we ship  <- the pin
#       9afe8a0  xlu: the pattern arrives beside the data
#         9e8f57c  The five bits are three fields, and an all-gather is one pass
#           58bb96f  Merge the cross-lane unit

# --- the distribution layer (setup/system.sh) ---------------------------------
# THE BASE IMAGE IS ubuntu:22.04 AND CARRIES NONE OF THIS. It used to be
# ghcr.io/psal-postech/torchsim_tnpu, which shipped its own LLVM, gem5, spike and TOGSim
# beside the ones built here -- 8.53 GB compressed, most of it a second copy. What the base
# really gave that nothing here rebuilds was python3.11, the TOGSim pair below, and the
# RISC-V toolchain + pk now restored by the `riscv` step.
#
# cmake 3.26.4 and conan 1.56.0 are the versions TOGSim's conanfile.txt was resolved with;
# restore.sh's build_tools() keeps LLVM 23's cmake 3.31.6 in a venv so these stay put.
HOST_CMAKE_VERSION=3.26.4
CONAN_VERSION=1.56.0
# The reference values every kernel is scored against: tests/runtime/stages.py calls
# spec.make_inputs(torch). CPU wheels only -- nothing here has, or wants, a GPU.
TORCH_VERSION=2.10.0

# --- install locations (pytorchsim_triton_compiler/toolchain.py defaults) ----------------------
# Every dependency is a sibling under /workspace, so the compiler's defaults need no env.
LLVM_ROOT=/workspace/LLVM_DIR/llvm-project
LLVM_INSTALL=/workspace/LLVM_DIR/llvm-project/build/install
# NOT /workspace/triton: that shadows the `triton` package as a namespace
# package for anything run from /workspace, and `import triton` then finds a
# directory with no __version__.
TRITON_ROOT=/workspace/triton-src
TRITON_BUILD=/workspace/triton-src/build
SPIKE_ROOT=/workspace/riscv-isa-sim
GEM5_ROOT=/workspace/gem5
# Where the base image put them, so TORCHSIM_COMPILE_PK and RISCV do not move.
RISCV_ROOT=/workspace/riscv
PK_ROOT=/workspace/riscv-pk
PK_BIN=/workspace/riscv-pk/build/pk
# The model Spike loads with --extlib; its source is the submodule.
VCIX_BUILD=/workspace/vcix-build
VCIX_MODEL=/workspace/vcix-build/libtpu.so
# The extension, built by the compiler image from extension/ against TRITON_BUILD.
EXT_BUILD=/workspace/torchsim-triton-ext-build

