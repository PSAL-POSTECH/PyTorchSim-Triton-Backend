# The compiler's /workspace defaults, moved under the prefix toolchain.sh laid. Source it.
_p=@PREFIX@

export TORCHSIM_COMPILE_DIR=@REPO@
export TORCHSIM_DIR=@PYTORCHSIM_ROOT@
case ":$PATH:" in *":$TORCHSIM_COMPILE_DIR:"*) ;; *) export PATH=$TORCHSIM_COMPILE_DIR:$PATH ;; esac

export TORCHSIM_LLVM_PATH=$_p/LLVM_DIR/llvm-project/build/install/bin
export TORCHSIM_COMPILE_LLVM_PATH=$TORCHSIM_LLVM_PATH
export TORCHSIM_COMPILE_TRITON_PYTHON=$_p/triton-src/python
export TORCHSIM_COMPILE_TRITON_EXT=$_p/torchsim-triton-ext-build/libtorchsim_triton_ext.so
export TORCHSIM_COMPILE_TORCHSIM_DIALECT=$_p/torchsim-dialect-build
export TORCHSIM_COMPILE_VCIX_MODEL=$_p/vcix-build/libtpu.so

_v=@VCIX_ENV_ROOT@
export TORCHSIM_COMPILE_SPIKE=$_v/spike/bin/spike
export TORCHSIM_COMPILE_PK=$_v/pk/riscv64-unknown-elf/bin/pk
export TORCHSIM_COMPILE_GEM5=$_v/gem5/build/RISCV/gem5.opt
export GEM5_PATH=$TORCHSIM_COMPILE_GEM5
export RISCV=$_v/riscv
case ":$PATH:" in *":$RISCV/bin:"*) ;; *) export PATH=$RISCV/bin:$PATH ;; esac
export TORCHSIM_COMPILE_RISCV_GCC=$RISCV/bin/riscv64-unknown-elf-gcc
export TORCHSIM_COMPILE_RISCV_OBJDUMP=$RISCV/bin/riscv64-unknown-elf-objdump
export TORCHSIM_COMPILE_RISCV_READELF=$RISCV/bin/riscv64-unknown-elf-readelf
export TORCHSIM_COMPILE_RISCV_NM=$RISCV/bin/riscv64-unknown-elf-nm

export TORCHSIM_COMPILE_TOGSIM_DIR=$TORCHSIM_DIR
export TORCHSIM_COMPILE_TOGSIM_INCLUDE=$TORCHSIM_DIR/TOGSim/include
export TORCHSIM_TRITON_CODEGEN=1
export LIT_USE_INTERNAL_SHELL=1

mkdir -p "$_p/run"
export TORCHSIM_DUMP_PATH=${TORCHSIM_DUMP_PATH:-$_p/run/dump-$$}
export TORCHSIM_LOG_PATH=$_p/run/togsim_results

PYTHONPATH="$(printf '%s' "${PYTHONPATH:-}" | tr ':' '\n' | grep -v -e '^/riscv-llvm/' -e '^/workspace/' | paste -sd: -; true)"
export PYTHONPATH="$TORCHSIM_DIR/PyTorchSimDevice:$TORCHSIM_DIR${PYTHONPATH:+:$PYTHONPATH}"

export TOGSIM_CONFIG=$TORCHSIM_DIR/configs/systolic_ws_256x256_c1_simple_noc_tpuv6e_functional_only.yml
export TORCHSIM_COMPILE_TARGET=$TORCHSIM_COMPILE_DIR/tests/targets/tpuv6e.json
for _f in "$TOGSIM_CONFIG" "$TORCHSIM_COMPILE_TARGET"; do
  [ -f "$_f" ] || echo "env.sh: MISSING $_f" >&2
done
unset _p _v _f
